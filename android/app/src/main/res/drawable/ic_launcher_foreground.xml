<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景层：108x108 画布，中心 72x72 是安全区（外围可能被裁成圆形/圆角）。
  图形（信封 + 折角）全部画在 36..72 范围内，任何裁切形状下都不会被切掉。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 信封主体 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M34,40 L74,40 A4,4 0 0 1 78,44 L78,68 A4,4 0 0 1 74,72 L34,72 A4,4 0 0 1 30,68 L30,44 A4,4 0 0 1 34,40 Z" />

    <!-- 折角（用品牌色描边，形成"信封盖"的观感） -->
    <path
        android:pathData="M30,45 L54,63 L78,45"
        android:strokeColor="#1F6FEB"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
